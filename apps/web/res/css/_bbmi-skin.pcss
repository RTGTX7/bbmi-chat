/* BBMI Chat visual skin. This file only changes presentation; Matrix behavior remains untouched. */

:root {
    --bbmi-green: #2e8b57;
    --bbmi-surface: #ffffff;
    --bbmi-surface-soft: #f4f8f5;
    --bbmi-border: rgb(24 79 48 / 12%);
    --bbmi-shadow: 0 8px 28px rgb(16 55 34 / 8%);
    --bbmi-incoming: #ffffff;
    --bbmi-outgoing: #2e8b57;
}

.cpd-theme-dark {
    --bbmi-surface: #151917;
    --bbmi-surface-soft: #101412;
    --bbmi-border: rgb(151 216 177 / 14%);
    --bbmi-shadow: 0 8px 28px rgb(0 0 0 / 24%);
    --bbmi-incoming: #222825;
    --bbmi-outgoing: #277a4b;
}

.mx_MatrixChat {
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--cpd-color-bg-canvas-default);
}

.mx_BBMIChat_mobileHeader,
.mx_BBMIChat_mobileBack,
.mx_BBMIChat_spaceDrawerBackdrop {
    display: none;
}

.mx_BBMIChat_spaceDrawer,
.mx_BBMIChat_spaceDrawerPanel {
    display: contents;
}

.mx_LeftPanel {
    background: var(--bbmi-surface-soft);
    border-inline-end: 1px solid var(--bbmi-border);
    transition: width 180ms ease, box-shadow 180ms ease;
}

.mx_LeftPanel_roomListContainer,
.mx_RoomListPanel {
    background: transparent;
}

.mx_LeftPanel .mx_SearchBox,
.mx_LeftPanel input {
    border-radius: 12px;
}

.mx_LeftPanel .mx_SearchBox {
    margin: 12px 14px;
    box-shadow: inset 0 0 0 1px var(--bbmi-border);
    transition: box-shadow 160ms ease, background-color 160ms ease;
}

.mx_LeftPanel .mx_SearchBox:focus-within {
    box-shadow: inset 0 0 0 2px var(--bbmi-green);
}

.mx_LeftPanel .mx_RoomListItem,
.mx_LeftPanel [role="treeitem"] {
    border-radius: 12px;
    margin: 2px 8px;
    transition: background-color 150ms ease, transform 150ms ease;
}

.mx_LeftPanel .mx_RoomListItem:hover,
.mx_LeftPanel [role="treeitem"]:hover {
    background: rgb(46 139 87 / 10%);
    transform: translateX(2px);
}

.mx_LeftPanel .mx_RoomListItem.mx_RoomListItem_selected,
.mx_LeftPanel [aria-selected="true"] {
    background: rgb(46 139 87 / 16%);
    box-shadow: inset 3px 0 0 var(--bbmi-green);
}

.mx_RoomListItemView {
    box-sizing: border-box;
    min-height: 68px;
    margin: 2px 10px;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 14px;
    transition: background-color 150ms ease, border-color 150ms ease, transform 150ms ease;
}

.mx_RoomListItemView:hover {
    border-color: var(--bbmi-border);
    background: rgb(46 139 87 / 8%);
    transform: translateX(2px);
}

.mx_RoomListItemView[aria-selected="true"] {
    border-color: rgb(46 139 87 / 16%);
    background: rgb(46 139 87 / 14%);
    box-shadow: inset 3px 0 0 var(--bbmi-green);
}

.mx_RoomListItemView [data-testid="avatar-img"] {
    --cpd-avatar-size: 46px !important;

    flex: 0 0 46px;
    font-size: 17px;
}

.mx_RoomListItemView [data-testid="avatar-img"] img {
    width: 46px;
    height: 46px;
}

.mx_RoomListItemView [data-testid="room-name"] {
    color: var(--cpd-color-text-primary);
    font-size: 15px;
    font-weight: 600;
}

.mx_RoomListPanel button[role="option"]:not(.mx_RoomListItemView) {
    min-height: 32px;
    padding-inline: 12px;
    border: 1px solid var(--bbmi-border);
    border-radius: 999px;
    background: var(--bbmi-surface);
    transition: background-color 150ms ease, border-color 150ms ease;
}

.mx_RoomListPanel button[role="option"]:not(.mx_RoomListItemView):hover,
.mx_RoomListPanel button[role="option"][aria-selected="true"]:not(.mx_RoomListItemView) {
    border-color: rgb(46 139 87 / 35%);
    background: rgb(46 139 87 / 10%);
}

.mx_RoomView {
    background: var(--bbmi-surface);
}

.mx_RoomHeader {
    height: 68px;
    padding-inline: 18px;
    border-bottom: 1px solid var(--bbmi-border);
    background: rgb(255 255 255 / 86%);
    backdrop-filter: blur(18px);
    transition: background-color 160ms ease, box-shadow 160ms ease;
}

.cpd-theme-dark .mx_RoomHeader {
    background: rgb(21 25 23 / 86%);
}

.mx_RoomHeader:hover {
    background-color: var(--bbmi-surface);
    box-shadow: 0 4px 18px rgb(16 55 34 / 5%);
}

.mx_RoomHeader .mx_BaseAvatar img {
    border-radius: 12px;
}

.mx_RoomHeader button {
    border-radius: 10px;
    transition: background-color 150ms ease, transform 150ms ease;
}

.mx_RoomHeader button:hover {
    transform: translateY(-1px);
}

.mx_RoomHeader_actions {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
}

.mx_RoomView_messagePanel {
    background: linear-gradient(180deg, var(--bbmi-surface) 0%, var(--bbmi-surface-soft) 100%);
}

.mx_RoomView_MessageList {
    padding-inline: clamp(12px, 3vw, 56px);
}

.mx_EventTile {
    animation: bbmi-message-in 180ms ease both;
}

.mx_EventTile[data-layout="bubble"] .mx_EventTile_line {
    border: 1px solid var(--bbmi-border);
    border-radius: 18px;
    box-shadow: 0 2px 10px rgb(16 55 34 / 5%);
    transition: box-shadow 150ms ease, transform 150ms ease;
}

.mx_EventTile[data-layout="bubble"]:hover .mx_EventTile_line {
    box-shadow: 0 5px 16px rgb(16 55 34 / 10%);
    transform: translateY(-1px);
}

.mx_EventTile[data-layout="bubble"][data-self="true"] {
    --backgroundColor: var(--bbmi-green);
}

.mx_EventTile[data-layout="bubble"][data-self="true"] .mx_EventTile_line {
    border-color: transparent;
    color: #fff;
}

.mx_EventTile[data-layout="bubble"][data-self="true"] .mx_EventTile_line a,
.mx_EventTile[data-layout="bubble"][data-self="true"] .mx_EventTile_line .mx_MessageTimestamp {
    color: rgb(255 255 255 / 78%);
}

.mx_EventTile[data-layout="group"]:not(.mx_EventTile_info):not(:has(.mx_cryptoEvent)) {
    padding-inline: clamp(14px, 4vw, 64px);
}

.mx_EventTile[data-layout="group"]:not(.mx_EventTile_info):not(:has(.mx_cryptoEvent)) .mx_EventTile_line {
    width: fit-content;
    max-width: min(72%, 680px);
    padding: 8px 12px;
    border: 1px solid var(--bbmi-border);
    border-radius: 16px 16px 16px 5px;
    background: var(--bbmi-incoming);
    box-shadow: 0 2px 10px rgb(16 55 34 / 6%);
}

.mx_EventTile[data-layout="group"][data-self="true"]:not(.mx_EventTile_info):not(:has(.mx_cryptoEvent))
    .mx_EventTile_line {
    margin-inline-start: auto;
    border-color: transparent;
    border-radius: 16px 16px 5px 16px;
    background: var(--bbmi-outgoing);
    color: #fff;
}

.mx_EventTile[data-layout="group"][data-self="true"]:not(.mx_EventTile_info):not(:has(.mx_cryptoEvent))
    .mx_EventTile_line
    a,
.mx_EventTile[data-layout="group"][data-self="true"]:not(.mx_EventTile_info):not(:has(.mx_cryptoEvent))
    .mx_MessageTimestamp {
    color: rgb(255 255 255 / 76%);
}

.mx_EventTile:has(.mx_cryptoEvent) {
    padding-inline: 14px;
}

.mx_EventTile:has(.mx_cryptoEvent) .mx_EventTile_line {
    width: min(100%, 600px);
    max-width: none;
    margin-inline: auto;
}

.mx_EventTile:has(.mx_cryptoEvent) .mx_cryptoEvent {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid var(--bbmi-border);
    border-radius: 12px;
}

.mx_MessageTimestamp {
    font-size: 11px;
    opacity: 0.76;
}

.mx_EventTile .mx_ReplyTile {
    border-inline-start: 3px solid var(--bbmi-green);
    border-radius: 8px;
    background: rgb(46 139 87 / 8%);
}

.mx_EventTile .mx_ImageBody_container,
.mx_EventTile .mx_MVideoBody_container,
.mx_EventTile .mx_MFileBody {
    overflow: hidden;
    border-radius: 14px;
}

.mx_ReactionsRowButton {
    border: 1px solid var(--bbmi-border);
    border-radius: 999px;
    transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
}

.mx_ReactionsRowButton:hover {
    border-color: rgb(46 139 87 / 45%);
    background: rgb(46 139 87 / 8%);
    transform: translateY(-1px);
}

.mx_MessageComposer_wrapper {
    border-top: 0;
    margin: 10px clamp(12px, 3vw, 56px) 16px;
    padding: 8px 10px 8px 16px;
    border: 1px solid var(--bbmi-border);
    border-radius: 18px;
    background: var(--bbmi-surface);
    box-shadow: var(--bbmi-shadow);
    transition: border-color 160ms ease, box-shadow 160ms ease;
}

.mx_MessageComposer_wrapper:focus-within {
    border-color: rgb(46 139 87 / 55%);
    box-shadow: 0 8px 30px rgb(46 139 87 / 14%);
}

.mx_MessageComposer_input textarea {
    background: transparent;
    padding: 8px 4px;
}

.mx_MessageComposer_button {
    border-radius: 10px;
    transition: background-color 150ms ease, transform 150ms ease;
}

.mx_MessageComposer_button:hover,
.mx_MessageComposer_sendMessage:hover {
    transform: scale(1.06);
}

.mx_MessageComposer_sendMessage {
    background: var(--bbmi-green);
    height: 20px;
    width: 20px;
    box-shadow: 0 4px 12px rgb(46 139 87 / 28%);
}

.mx_SettingsPage .mx_SettingsTab,
.mx_SettingsTab .mx_SettingsSection {
    border-radius: 14px;
}

.mx_TabbedView_tabLabel {
    border-radius: 10px;
    transition: background-color 150ms ease, color 150ms ease;
}

.mx_TabbedView_tabLabel:hover,
.mx_TabbedView_tabLabel_active {
    background: rgb(46 139 87 / 10%);
}

.mx_TabbedView_tabLabel_active {
    box-shadow: inset 3px 0 0 var(--bbmi-green);
}

.mx_ContextualMenu,
.mx_Dialog {
    border: 1px solid var(--bbmi-border);
    border-radius: 14px;
    background: var(--bbmi-surface);
    box-shadow: 0 18px 50px rgb(16 55 34 / 18%);
    animation: bbmi-surface-in 140ms ease both;
}

.mx_Dialog button,
.mx_AccessibleButton_kind_primary {
    transition: box-shadow 150ms ease, transform 150ms ease;
}

.mx_Dialog button:hover,
.mx_AccessibleButton_kind_primary:hover {
    transform: translateY(-1px);
}

.mx_AccessibleButton_kind_primary {
    background-color: var(--bbmi-green);
    box-shadow: 0 5px 14px rgb(46 139 87 / 22%);
}

.mx_MatrixChat button:focus-visible,
.mx_MatrixChat [role="button"]:focus-visible,
.mx_MatrixChat [role="option"]:focus-visible,
.mx_Dialog button:focus-visible {
    outline: 2px solid var(--bbmi-green);
    outline-offset: 2px;
}

.mx_SettingsTab .mx_SettingsSection {
    background: var(--bbmi-surface);
    box-shadow: var(--bbmi-shadow);
    border: 1px solid var(--bbmi-border);
    padding: 18px;
}

.mx_AuthPage {
    background: radial-gradient(circle at 15% 10%, rgb(46 139 87 / 20%), transparent 38%), var(--bbmi-surface-soft);
}

.mx_AuthPage_modal {
    border: 1px solid var(--bbmi-border);
    box-shadow: 0 22px 60px rgb(16 55 34 / 16%);
    overflow: hidden;
}

.mx_AuthHeaderLogo {
    text-align: center;
}

.mx_AuthHeaderLogo img {
    max-width: 190px;
}

.mx_AuthHeaderLogo_mark {
    display: grid;
    width: 72px;
    height: 72px;
    margin: 0 auto;
    place-items: center;
    border-radius: 20px;
    background: var(--bbmi-green);
    box-shadow: 0 10px 26px rgb(46 139 87 / 28%);
    color: #fff;
    font-size: 38px;
    font-weight: 700;
}

.mx_AuthHeaderLogo_brand {
    display: block;
    margin-top: 12px;
    color: var(--bbmi-green);
    font-size: 22px;
    font-weight: 700;
    white-space: nowrap;
}

@keyframes bbmi-message-in {
    from {
        opacity: 0;
        transform: translateY(4px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes bbmi-surface-in {
    from {
        opacity: 0;
        transform: translateY(4px) scale(0.99);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_EventTile {
        animation: none;
    }

    .mx_ContextualMenu,
    .mx_Dialog {
        animation: none;
    }

    .mx_LeftPanel, .mx_LeftPanel [role="treeitem"], .mx_EventTile_line, .mx_MessageComposer_button { transition: none; }
}

@media (max-width: 700px) {
    .mx_LeftPanel {
        border-inline-end: 0;
    }

    .mx_RoomView_MessageList {
        padding-inline: 10px;
    }

    .mx_RoomHeader {
        height: 60px;
        padding-inline: 10px;
    }

    .mx_RoomHeader_info {
        padding-right: 4px;
    }

    .mx_MessageComposer_wrapper {
        min-height: 54px;
        margin: 8px 10px calc(10px + env(safe-area-inset-bottom));
        padding: 4px 6px 4px 12px;
        border-radius: 18px;
    }

    .mx_AuthFooter {
        display: none;
    }

    .mx_Dialog {
        max-width: calc(100vw - 20px);
        max-height: calc(100vh - 20px);
        border-radius: 12px;
    }
}

@media (max-width: 767px) {
    html,
    body,
    #matrixchat {
        height: 100dvh;
        min-height: 100dvh;
        overflow: hidden;
    }

    .mx_MatrixChat_wrapper,
    .mx_MatrixChat {
        height: 100dvh;
        min-height: 0;
    }

    .mx_MatrixChat .mx_Separator {
        display: none;
    }

    .mx_BBMIChat_mobileHeader {
        box-sizing: border-box;
        display: flex;
        height: calc(64px + env(safe-area-inset-top));
        flex: 0 0 auto;
        align-items: center;
        gap: 10px;
        padding: calc(10px + env(safe-area-inset-top)) 14px 10px;
        border-bottom: 1px solid var(--bbmi-border);
        background: var(--bbmi-surface);
    }

    .mx_RoomListPanel {
        overflow: hidden;
    }

    .mx_RoomListPanel > [role="listbox"] {
        padding-inline: 4px;
    }

    .mx_RoomListPanel [role="listbox"]:has(> button[role="option"]:not(.mx_RoomListItemView)) {
        overflow-x: auto;
        padding: 2px 12px 8px;
        scrollbar-width: none;
    }

    .mx_RoomListPanel [role="listbox"]:has(> button[role="option"]:not(.mx_RoomListItemView))::-webkit-scrollbar {
        display: none;
    }

    .mx_RoomListItemView {
        min-height: 72px;
        margin-inline: 8px;
        padding-inline: 10px;
    }

    .mx_EventTile[data-layout="group"]:not(.mx_EventTile_info):not(:has(.mx_cryptoEvent)) {
        padding-inline: 10px;
    }

    .mx_EventTile[data-layout="group"]:not(.mx_EventTile_info):not(:has(.mx_cryptoEvent)) .mx_EventTile_line {
        max-width: 82%;
    }

    .mx_BBMIChat_mobileMenuButton,
    .mx_BBMIChat_mobileBack {
        display: grid;
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        padding: 0;
        place-items: center;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: var(--cpd-color-icon-primary);
        cursor: pointer;
    }

    .mx_BBMIChat_mobileMenuButton:hover,
    .mx_BBMIChat_mobileBack:hover {
        background: rgb(46 139 87 / 10%);
    }

    .mx_BBMIChat_mobileMenuButton svg,
    .mx_BBMIChat_mobileBack svg {
        width: 24px;
        height: 24px;
    }

    .mx_BBMIChat_mobileBrandMark {
        display: grid;
        width: 34px;
        height: 34px;
        place-items: center;
        border-radius: 10px;
        background: var(--bbmi-green);
        color: #fff;
        font-size: 18px;
        font-weight: 700;
    }

    .mx_BBMIChat_mobileBrand {
        min-width: 0;
        color: var(--cpd-color-text-primary);
        font-size: 20px;
        font-weight: 700;
    }

    .mx_BBMIChat_spaceDrawer {
        position: fixed;
        z-index: 6000;
        display: block;
        visibility: hidden;
        inset: 0;
        pointer-events: none;
    }

    .mx_BBMIChat_spaceDrawer_open {
        visibility: visible;
        pointer-events: auto;
    }

    .mx_BBMIChat_spaceDrawerBackdrop {
        position: absolute;
        display: block;
        inset: 0;
        border: 0;
        background: rgb(0 0 0 / 42%);
        opacity: 0;
        transition: opacity 180ms ease;
    }

    .mx_BBMIChat_spaceDrawer_open .mx_BBMIChat_spaceDrawerBackdrop {
        opacity: 1;
    }

    .mx_BBMIChat_spaceDrawerPanel {
        position: absolute;
        display: block;
        width: min(78vw, 300px);
        inset: 0 auto 0 0;
        padding-top: env(safe-area-inset-top);
        background: var(--bbmi-surface);
        box-shadow: 16px 0 40px rgb(0 0 0 / 20%);
        transform: translateX(-100%);
        transition: transform 200ms ease;
    }

    .mx_BBMIChat_spaceDrawer_open .mx_BBMIChat_spaceDrawerPanel {
        transform: translateX(0);
    }

    .mx_BBMIChat_spaceDrawerPanel .mx_SpacePanel {
        display: flex;
        height: 100%;
        border: 0;
    }

    .mx_BBMIChat_listPane,
    .mx_BBMIChat_detailPaneWrapper,
    .mx_BBMIChat_detailPane {
        width: 100% !important;
        min-width: 0 !important;
        max-width: none !important;
        height: 100%;
    }

    .mx_MatrixChat div[data-panel]:has(> .mx_BBMIChat_listPane),
    .mx_MatrixChat div[data-panel]:has(> .mx_BBMIChat_detailPaneWrapper) {
        width: 100% !important;
        max-width: none !important;
        flex: 1 1 100% !important;
    }

    .mx_MatrixChat[data-mobile-pane="list"] div[data-panel]:has(> .mx_BBMIChat_detailPaneWrapper),
    .mx_MatrixChat[data-mobile-pane="detail"] div[data-panel]:has(> .mx_BBMIChat_listPane) {
        display: none !important;
    }

    .mx_MatrixChat[data-mobile-pane="list"] .mx_BBMIChat_detailPaneWrapper,
    .mx_MatrixChat[data-mobile-pane="list"] > .mx_BBMIChat_detailPane,
    .mx_MatrixChat[data-mobile-pane="detail"] .mx_BBMIChat_listPane {
        display: none;
    }

    .mx_MatrixChat[data-mobile-pane="list"] .mx_BBMIChat_listPane,
    .mx_MatrixChat[data-mobile-pane="detail"] .mx_BBMIChat_detailPaneWrapper,
    .mx_MatrixChat[data-mobile-pane="detail"] > .mx_BBMIChat_detailPane {
        display: flex;
        flex: 1 1 100%;
    }

    .mx_LeftPanel_outerWrapper {
        width: 100%;
        max-width: none;
    }

    .mx_LeftPanel,
    .mx_LeftPanel_roomListContainer {
        width: 100%;
        height: 100%;
    }

    .mx_RoomView_wrapper,
    .mx_RoomView,
    .mx_RoomView_body {
        min-width: 0;
        max-width: 100%;
        height: 100%;
    }

    .mx_RoomView,
    .mx_RoomView_body,
    .mx_RoomView_messagePanel,
    .mx_RoomView_MessageList {
        overflow-x: clip;
    }

    .mx_RoomHeader {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        gap: 6px !important;
    }

    .mx_RoomHeader_infoWrapper,
    .mx_RoomHeader_info,
    .mx_RoomHeader_heading,
    .mx_RoomHeader_truncated {
        min-width: 0;
        max-width: 100%;
    }

    .mx_RoomHeader_infoWrapper {
        flex: 1 1 auto;
        overflow: hidden;
    }

    .mx_RoomHeader_heading,
    .mx_RoomHeader_truncated {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_EventTile,
    .mx_EventTile_line,
    .mx_EventTile_reply,
    .mx_EventTile_content,
    .mx_EventTile_body,
    .mx_ReplyTile,
    .mx_ReactionsRow {
        box-sizing: border-box;
        min-width: 0;
        max-width: 100%;
    }

    .mx_EventTile_content,
    .mx_EventTile_body,
    .mx_EventTile_content .markdown-body {
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .mx_EventTile_content .markdown-body pre {
        max-width: 100%;
        overflow-x: auto;
    }

    .mx_RoomView_timeline_rr_enabled .mx_EventTile[data-layout="group"] .mx_EventTile_line {
        margin-inline-end: 0;
    }

    .mx_EventTile .mx_ImageBody,
    .mx_EventTile .mx_ImageBody_container,
    .mx_EventTile .mx_MVideoBody,
    .mx_EventTile .mx_MVideoBody_container,
    .mx_EventTile .mx_MFileBody,
    .mx_EventTile img,
    .mx_EventTile video {
        box-sizing: border-box;
        min-width: 0;
        max-width: 100%;
    }

    .mx_LegacyCallEvent_wrapper,
    .mx_CallEvent_wrapper {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    .mx_LegacyCallEvent_wrapper .mx_LegacyCallEvent,
    .mx_LegacyCallEvent_wrapper .mx_LegacyCallEvent.mx_LegacyCallEvent_narrow,
    .mx_CallEvent {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        padding: 12px 14px;
    }

    .mx_LegacyCallEvent_info,
    .mx_LegacyCallEvent_info_basic,
    .mx_LegacyCallEvent_content,
    .mx_CallEvent_columns,
    .mx_CallEvent_details {
        min-width: 0;
        max-width: 100%;
    }

    .mx_LegacyCallEvent_content {
        margin-inline-start: 42px;
    }

    .mx_CallEvent_columns {
        flex-wrap: wrap;
    }

    .mx_CallEvent_button {
        width: 100%;
        min-width: 0;
    }

    .mx_MessageComposer_row {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        gap: 4px;
    }

    .mx_MessageComposer_input {
        flex: 1 1 0;
        min-width: 0;
        max-width: 100%;
        min-height: 46px;
        margin-right: 0;
        overflow: hidden;
    }

    .mx_MessageComposer_input textarea {
        box-sizing: border-box;
        min-height: 42px;
        margin: 0;
        padding: 10px 2px;
    }

    .mx_MessageComposer_actions {
        flex: 0 0 auto;
        min-width: 0;
        max-width: 100%;
        gap: 2px;
    }

    .mx_MessageComposer_button,
    .mx_MessageComposer_actions button {
        box-sizing: border-box;
        display: grid;
        width: 38px;
        height: 38px;
        min-width: 38px;
        padding: 8px;
        place-items: center;
        border-radius: 12px;
    }

    .mx_MessageComposer_button svg,
    .mx_MessageComposer_actions button svg {
        width: 20px;
        height: 20px;
    }

    .mx_MessageComposer_sendMessage {
        width: 40px;
        height: 40px;
        min-width: 40px;
        padding: 10px;
        background: var(--bbmi-green);
        box-shadow: 0 5px 14px rgb(46 139 87 / 28%);
    }

    .mx_UserSettingsDialog,
    .mx_RoomSettingsDialog,
    .mx_SpaceSettingsDialog,
    .mx_SpacePreferencesDialog {
        box-sizing: border-box;
        width: 100vw;
        max-width: none;
        height: 100dvh;
        max-height: none;
        padding: 14px 16px;
        overflow: hidden;
        border-radius: 0;
    }

    .mx_Dialog_wrapper:has(.mx_UserSettingsDialog) .mx_Dialog_border,
    .mx_Dialog_wrapper:has(.mx_RoomSettingsDialog) .mx_Dialog_border,
    .mx_Dialog_wrapper:has(.mx_SpaceSettingsDialog) .mx_Dialog_border,
    .mx_Dialog_wrapper:has(.mx_SpacePreferencesDialog) .mx_Dialog_border {
        width: 100%;
        max-width: none;
        height: 100%;
        max-height: none;
    }

    .mx_UserSettingsDialog .mx_Dialog_header,
    .mx_RoomSettingsDialog .mx_Dialog_header,
    .mx_SpaceSettingsDialog .mx_Dialog_header,
    .mx_SpacePreferencesDialog .mx_Dialog_header {
        box-sizing: border-box;
        min-height: 42px;
        margin: 0;
        padding-inline-end: 44px;
    }

    .mx_UserSettingsDialog .mx_Dialog_cancelButton,
    .mx_RoomSettingsDialog .mx_Dialog_cancelButton,
    .mx_SpaceSettingsDialog .mx_Dialog_cancelButton,
    .mx_SpacePreferencesDialog .mx_Dialog_cancelButton {
        top: 14px;
        right: 16px;
    }

    .mx_UserSettingsDialog .mx_TabbedView,
    .mx_RoomSettingsDialog .mx_TabbedView,
    .mx_SpaceSettingsDialog .mx_TabbedView,
    .mx_SpacePreferencesDialog .mx_TabbedView {
        top: 58px;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        flex-direction: column;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels,
    .mx_RoomSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels,
    .mx_SpaceSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels,
    .mx_SpacePreferencesDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels {
        position: static;
        box-sizing: border-box;
        display: flex;
        width: 100%;
        max-width: none;
        height: 54px;
        flex: 0 0 54px;
        gap: 4px;
        margin: 0;
        padding: 6px 12px;
        overflow-x: auto;
        overflow-y: hidden;
        border-bottom: 1px solid var(--bbmi-border);
        background: var(--bbmi-surface);
        scrollbar-width: none;
        overscroll-behavior-inline: contain;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabLabels::-webkit-scrollbar,
    .mx_RoomSettingsDialog .mx_TabbedView_tabLabels::-webkit-scrollbar,
    .mx_SpaceSettingsDialog .mx_TabbedView_tabLabels::-webkit-scrollbar,
    .mx_SpacePreferencesDialog .mx_TabbedView_tabLabels::-webkit-scrollbar {
        display: none;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabLabel,
    .mx_RoomSettingsDialog .mx_TabbedView_tabLabel,
    .mx_SpaceSettingsDialog .mx_TabbedView_tabLabel,
    .mx_SpacePreferencesDialog .mx_TabbedView_tabLabel {
        display: grid;
        width: 42px;
        min-width: 42px;
        height: 42px;
        min-height: 42px;
        flex: 0 0 42px;
        padding: 0;
        place-items: center;
        border-radius: 10px;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabLabel svg,
    .mx_RoomSettingsDialog .mx_TabbedView_tabLabel svg,
    .mx_SpaceSettingsDialog .mx_TabbedView_tabLabel svg,
    .mx_SpacePreferencesDialog .mx_TabbedView_tabLabel svg {
        margin: 0;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabLabel_active,
    .mx_RoomSettingsDialog .mx_TabbedView_tabLabel_active,
    .mx_SpaceSettingsDialog .mx_TabbedView_tabLabel_active,
    .mx_SpacePreferencesDialog .mx_TabbedView_tabLabel_active {
        box-shadow: inset 0 -3px 0 var(--bbmi-green);
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabPanel,
    .mx_RoomSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabPanel,
    .mx_SpaceSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabPanel,
    .mx_SpacePreferencesDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabPanel {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        min-height: 0;
        flex: 1 1 auto;
        margin-left: 0;
        overflow: hidden;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabPanelContent,
    .mx_RoomSettingsDialog .mx_TabbedView_tabPanelContent,
    .mx_SpaceSettingsDialog .mx_TabbedView_tabPanelContent,
    .mx_SpacePreferencesDialog .mx_TabbedView_tabPanelContent {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        overflow-x: hidden;
    }

    .mx_UserSettingsDialog .mx_TabbedView .mx_SettingsTab,
    .mx_RoomSettingsDialog .mx_TabbedView .mx_SettingsTab,
    .mx_SpaceSettingsDialog .mx_TabbedView .mx_SettingsTab,
    .mx_SpacePreferencesDialog .mx_TabbedView .mx_SettingsTab {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        padding: 14px 12px calc(32px + env(safe-area-inset-bottom));
    }

    .mx_SettingsTab .mx_SettingsSection,
    .mx_SettingsTab_sections,
    .mx_SettingsSection_subSections,
    .mx_UserProfileSettings,
    .mx_UserProfileSettings_profile,
    .mx_UserProfileSettings_profile_controls,
    .mx_UserProfileSettings_profile_nameAndStatus,
    .mx_UserProfileSettings_profile_displayName {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    .mx_SettingsTab .mx_SettingsSection {
        padding: 16px;
    }

    .mx_SettingsTab_section .mx_SettingsFlag,
    .mx_SettingsTab_section > p,
    .mx_SettingsTab_subsectionText {
        margin-inline-end: 0;
    }

    .mx_SettingsTab .mx_Field,
    .mx_SettingsTab .mx_CopyableText,
    .mx_SettingsTab input,
    .mx_SettingsTab select,
    .mx_SettingsTab textarea {
        box-sizing: border-box;
        min-width: 0;
        max-width: 100%;
    }

    .mx_SettingsTab h1,
    .mx_SettingsTab h2,
    .mx_SettingsTab h3,
    .mx_SettingsTab p,
    .mx_SettingsTab label {
        overflow-wrap: anywhere;
    }

    .mx_SettingsTab table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
    }

    .mx_RightPanel_ResizeWrapper {
        position: fixed !important;
        z-index: 4500;
        width: 100vw !important;
        inset: 0;
    }

    .mx_RightPanel_ResizeWrapper .mx_RightPanel {
        width: 100% !important;
        max-width: none !important;
        border-left: 0;
    }

    .mx_RoomHeader > .mx_BBMIChat_mobileBack {
        display: grid;
        margin-inline-end: -6px;
    }

    .mx_RoomHeader_actions {
        flex: 0 0 auto;
        gap: 2px;
    }

    .mx_RoomHeader_actions > :nth-child(n + 3) {
        display: none;
    }
}

@media (max-width: 380px) {
    .mx_MessageComposer_wrapper {
        margin-inline: 6px;
        padding-inline: 8px 4px;
    }

    .mx_MessageComposer_button,
    .mx_MessageComposer_actions button {
        width: 34px;
        min-width: 34px;
        height: 34px;
        padding: 7px;
    }

    .mx_RoomHeader {
        padding-inline: 6px;
    }

    .mx_RoomHeader_actions {
        gap: 0;
    }
}

@media (min-width: 768px) {
    #left-panel {
        min-width: 280px !important;
        max-width: 370px !important;
        flex: 0 1 clamp(280px, 26vw, 370px) !important;
    }
}
